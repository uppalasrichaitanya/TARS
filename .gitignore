.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Build artifacts. `python -m build` leaves a full copy of the source tree in
# build/, which ruff and mypy then walk as if it were real code. Worth ignoring
# on its own, and worth ignoring twice because overnight_build.sh checkpoints
# with `git add -A`.
build/
dist/

# Credentials. Nothing here reads a .env today — the provider adapters take
# their tokens from the environment — but `git add -A` means a stray one would
# be committed on the next checkpoint, and an AgentRouter key is a live secret.
.env
.env.*
!.env.example

# Dev scaffolding — not part of the product, not shipped to PyPI.
# Kept locally if needed, but never committed (overnight_build.sh used
# `git add -A` which would otherwise commit them).
overnight_build.sh
run/
.tars/
.tars-proposals/

# Working prompt drafts — harness prompt + scratch docs. Useful during
# development, but not part of the repo or the wheel.
docs/
tars_prompts/
tars-prompts/

# Local assistant configs
.claude/

# Handover / internal docs — kept locally for development, not part of
# the published package. The public README is the user-facing entry point.
AGENTS.md
map.md
master_agent_loop.md
V1.md

# Tool caches that write their own ignore files, listed anyway so a fresh
# checkout on a machine with older tooling behaves the same.
.ruff_cache/
.mypy_cache/
